# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.

# --- Spend gate ---
# Model calls are DENIED unless this is exactly "allow". Default-deny is
# deliberate: forgetting to enable spending costs nothing, forgetting to
# disable it costs money.
#
# The running app needs this set. Command-line scripts need it AND a typed
# --allow-spend on that invocation, so a standing permission here can never
# make a script spend on its own.
#
# Free checks are unaffected: npm test, npm run check-routing, check-grounding.
LLM_SPEND=

# --- Model providers ---
# You need at least one. Preference order is OpenAI, then Anthropic, then
# Google: the first one with a key becomes the primary, and the next distinct
# one runs the adversarial pass.
#
# Two keys is the intended setup. The adversarial pass is meant to run on a
# DIFFERENT lab's model than the scoring pass — a model reviewing its own
# reasoning shares its own blind spots, and every model flatters resumes in the
# same direction. With one key it degrades to self-critique, which still helps
# but catches noticeably less.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- GitHub (optional) ---
# Unauthenticated GitHub allows 60 requests/hour, and reading one profile costs
# roughly one call per repository — so about four profile reads before it stops.
# Any token with public-repo scope lifts this to 5000/hour.
GITHUB_TOKEN=

# --- Google tier ---
# Google's FREE Gemini tier trains on what you send it and permits human
# review: "Google uses the content you submit to the Services and any generated
# responses to provide, improve, and develop Google products", and "human
# reviewers may read, annotate, and process your API input and output". The
# PAID tier does not.
#
# Nothing in the API response reveals which tier a key is on, so the code
# assumes free and refuses to send any CV content to Google. It will still use
# Google for the job posting, which is public text.
#
# Set this to true ONLY if the key above is on a billed Google Cloud project.
GOOGLE_PAID_TIER=

# --- Model routing (optional) ---
# Format: provider:model-id. A comma-separated list is a fallback chain, tried
# in order — useful on free tiers, where the first model is rate-limited long
# before the work is done. See src/lib/llm.ts for the stage list.
#
# MODEL_DEFAULT=openai:gpt-5
# MODEL_MATCH=openai:gpt-5
# MODEL_ADVERSARY=anthropic:claude-opus-4-8,google:gemini-flash-latest

# --- Sign-in (optional; the app works fully without accounts) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Required in production so callback URLs are built against the real host.
AUTH_URL=https://career-side-quests.gtfoo.com

# Magic link. Resend free tier is 3,000 emails/month, which is far more than a
# portfolio project needs. The FROM domain must be verified in Resend or mail
# is rejected. Do NOT run your own SMTP — a fresh droplet IP lands in spam.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=login@career-side-quests.gtfoo.com

# OAuth. Each needs its callback registered exactly:
#   https://career-side-quests.gtfoo.com/api/auth/callback/github
#   http://localhost:3002/api/auth/callback/github   (a separate dev app)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Where the SQLite file lives. Defaults to ./data/app.db, which is gitignored
# and survives deploys.
# DB_PATH=
