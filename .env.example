# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.

# --- Model providers ---
# You need at least one. The adversarial pass is meant to run on a DIFFERENT
# lab's model than the scoring pass (same-model self-critique shares the same
# blind spots), so two keys is the intended setup.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# --- Model routing (optional) ---
# Format: provider:model-id. A comma-separated list is a fallback chain, tried
# in order — useful for free tiers, where the first model is rate-limited long
# before the work is done. See src/lib/llm.ts for stage defaults.
#
# MODEL_DEFAULT=anthropic:claude-opus-4-8
# MODEL_EXTRACT_JD=google:gemini-flash-latest
# MODEL_MATCH=anthropic:claude-opus-4-8
# MODEL_ADVERSARY=google:gemini-flash-latest,openai:gpt-5
